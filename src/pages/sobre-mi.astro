---
// src/pages/sobre-mi.astro
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import About from "../components/About.astro";

// Imagen artística de prueba. Luego la cambias por la de tu primo.
const bgSobreMi =
  "https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?q=80&w=2545&auto=format&fit=crop";
---

<Layout title="Sobre Mí - Pbpetrus">
  <Nav />

  <main
    class="relative w-full min-h-screen bg-cover bg-center bg-no-repeat bg-fixed pt-80 pb-16"
    style={`background-image: url('${bgSobreMi}');`}
  >
    <div class="absolute inset-0 bg-black/70"></div>

    <div class="relative z-10">
      <About />
    </div>
  </main>
</Layout>
