---
// src/components/About.astro

const profileImg = "/perfil-pedro.jfif";
---

<section id="sobre-mi" class="py-32 px-6 max-w-6xl mx-auto scroll-mt-32">
  <div class="flex justify-center mb-20">
    <div
      class="reveal-item opacity-0 transform translate-y-8 border border-white/20 rounded-full px-10 py-3 bg-[#121212]/30 backdrop-blur-sm"
    >
      <h2 class="text-2xl text-white font-serif tracking-wide">Sobre Mí</h2>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-stretch">
    <div
      class="reveal-item opacity-0 transform translate-y-8 md:col-span-4 flex"
    >
      <div
        class="w-full rounded-2xl border border-white/10 overflow-hidden bg-[#121212]/20 backdrop-blur-sm aspect-[4/5] md:aspect-auto"
      >
        <img
          src={profileImg}
          alt="Autorretrato de Pedro"
          class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      </div>
    </div>

    <div
      class="reveal-item opacity-0 transform translate-y-8 md:col-span-8 flex"
    >
      <div
        class="w-full rounded-2xl border border-white/10 p-8 md:p-12 bg-[#121212]/40 backdrop-blur-md flex flex-col justify-center gap-6"
      >
        <h3 class="text-3xl font-serif text-white font-semibold">
          Hola, soy Pedro (Pbpetrus)
        </h3>

        <p class="text-white/70 text-lg leading-relaxed font-sans">
          Soy un ilustrador y artista visual enfocado en dar vida a mundos e
          historias a través del dibujo digital y tradicional. Mi trabajo
          transita de manera constante entre el diseño de personajes, la
          narrativa gráfica y el desarrollo de piezas conceptuales con una
          fuerte identidad de autor.
        </p>

        <p class="text-white/70 text-lg leading-relaxed font-sans">
          Formado en el ámbito del diseño y la ilustración profesional, me
          apasiona experimentar con paletas de colores contrastantes,
          composiciones dinámicas y texturas orgánicas que permitan que cada
          pieza se comunique por sí sola.
        </p>

        <p class="text-white/70 text-lg leading-relaxed font-sans">
          He colaborado en diversos proyectos independientes, arte para portadas
          y comisiones a medida, buscando siempre traducir ideas complejas en un
          lenguaje visual pulido, atractivo y con carácter.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const initRevealAnimation = () => {
    const itemsReveal = document.querySelectorAll(".reveal-item");

    const observerOptions = {
      root: null,
      rootMargin: "0px 0px -15% 0px",
      threshold: 0,
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-8");
          entry.target.classList.add(
            "opacity-100",
            "translate-y-0",
            "transition-all",
            "duration-700",
            "ease-out",
          );
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    itemsReveal.forEach((item) => revealObserver.observe(item));
  };

  initRevealAnimation();
</script>
