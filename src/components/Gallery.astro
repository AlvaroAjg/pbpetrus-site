---

const obras = [
  
  { src: "/amor.png", title: "Amor", alt: "Ilustración Amor" },
  { src: "/placer.png", title: "Placer", alt: "Ilustración Placer" },
  { src: "/parasito.png", title: "Parásito", alt: "Ilustración Parásito" },
  { src: "/consumismo.png", title: "Consumismo", alt: "Ilustración Consumismo" },
  
  
  { src: "/Rata 2.png", alt: "Rata 2" },
  { src: "/Print.jpg", alt: "Print" },
  { src: "/Print (1).jpg", alt: "Print 1" },
  { src: "/Saturno2.png", alt: "Saturno" },
  { src: "/ilustracion.png", alt: "Ilustración sin título" },
  { src: "/escaner.jpg", alt: "Escáner 20260426 2" },
  { src: "/Escáner_20250815.png", alt: "Escáner 20250815" },
  { src: "/calaca.jpg", alt: "Calaca" }
];

const obrasDestacadas = obras.slice(0, 4); 
const obrasRestantes = obras.slice(4);     
---

<section id="galeria" class="pb-24 pt-12 px-4 md:px-8 max-w-[1400px] mx-auto">
  
  
  <div class="text-center mb-14 mt-4">
    <h2 class="text-4xl md:text-5xl text-white font-serif tracking-widest uppercase [text-shadow:_0_2px_15px_rgb(220_38_38_/_60%)]">
      Trabajos
    </h2>
    <div class="w-16 md:w-24 h-1 bg-red-600 mx-auto mt-4 rounded-full shadow-[0_0_10px_rgba(220,38,38,0.8)]"></div>
  </div>

  
  <div class="columns-1 md:columns-2 lg:columns-4 gap-6 mb-6">
    {obrasDestacadas.map((obra) => (
      <div 
        class="gallery-item cursor-pointer relative group break-inside-avoid overflow-hidden rounded-xl border border-white/10 shadow-2xl bg-[#121212] mb-6"
        data-src={obra.src}
        data-title={obra.title}
      >
        <img 
          src={obra.src} 
          alt={obra.alt} 
          class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
        
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent flex items-end p-6 md:p-8 pointer-events-none">
          <h3 class="text-white font-serif text-2xl md:text-3xl tracking-widest uppercase [text-shadow:_0_2px_15px_rgb(220_38_38_/_80%)] group-hover:text-red-400 transition-colors duration-300">
            {obra.title}
          </h3>
        </div>
      </div>
    ))}
  </div>

  
  <div class="columns-1 md:columns-2 lg:columns-3 gap-6">
    {obrasRestantes.map((obra) => (
      <div 
        class="gallery-item cursor-pointer relative group break-inside-avoid overflow-hidden rounded-xl border border-white/10 shadow-2xl bg-[#121212] mb-6"
        data-src={obra.src}
      >
        <img 
          src={obra.src} 
          alt={obra.alt} 
          class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
       
        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-sm pointer-events-none">
           <svg class="w-12 h-12 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
        </div>
      </div>
    ))}
  </div>

</section>

<div id="imageModal" class="fixed inset-0 z-[100] bg-black/95 hidden flex-col justify-center items-center opacity-0 transition-opacity duration-300 backdrop-blur-md cursor-pointer">
   <button class="absolute top-6 right-6 md:top-10 md:right-10 text-white/50 hover:text-white transition-colors z-50">
     <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
   </button>
   
   <img id="modalImg" src="" alt="Ilustración ampliada" class="max-w-[90vw] max-h-[80vh] object-contain drop-shadow-2xl scale-95 transition-transform duration-300" />
   
   <h3 id="modalTitle" class="mt-6 text-white font-serif text-2xl md:text-3xl tracking-widest uppercase [text-shadow:_0_2px_15px_rgb(220_38_38_/_60%)] hidden"></h3>
</div>


<script>
  const initGalleryModal = () => {
    const modal = document.getElementById('imageModal');
    const modalImg = document.getElementById('modalImg');
    const modalTitle = document.getElementById('modalTitle');
    const items = document.querySelectorAll('.gallery-item');

    if (!modal || !modalImg || !modalTitle) return;

    items.forEach(item => {
      item.addEventListener('click', () => {
        const src = item.getAttribute('data-src');
        const title = item.getAttribute('data-title');

        if (src) modalImg.setAttribute('src', src);
        
        if (title && title !== "undefined" && title.trim() !== "") {
          modalTitle.textContent = title;
          modalTitle.classList.remove('hidden');
        } else {
          modalTitle.classList.add('hidden');
        }

        modal.classList.remove('hidden');
        modal.classList.add('flex');
        
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          modalImg.classList.remove('scale-95');
          modalImg.classList.add('scale-100');
        }, 10);
      });
    });

    modal.addEventListener('click', () => {
      modal.classList.add('opacity-0');
      modalImg.classList.remove('scale-100');
      modalImg.classList.add('scale-95');
      
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        modalImg.setAttribute('src', ''); 
      }, 300);
    });
  };

  document.addEventListener('DOMContentLoaded', initGalleryModal);
  document.addEventListener('astro:page-load', initGalleryModal);
</script>