---
// src/components/Gallery.astro

const placeholderImages = [
  { src: "https://picsum.photos/seed/1/600/800", alt: "Ilustración 1" },
  { src: "https://picsum.photos/seed/2/600/600", alt: "Ilustración 2" },
  { src: "https://picsum.photos/seed/3/800/600", alt: "Ilustración 3" },
  { src: "https://picsum.photos/seed/4/600/900", alt: "Ilustración 4" },
  { src: "https://picsum.photos/seed/5/600/600", alt: "Ilustración 5" },
  { src: "https://picsum.photos/seed/6/800/800", alt: "Ilustración 6" },
  { src: "https://picsum.photos/seed/7/600/400", alt: "Ilustración 7" },
  { src: "https://picsum.photos/seed/8/600/800", alt: "Ilustración 8" },
];
---

<section
  id="galeria"
  class="relative w-full min-h-screen bg-[#121212] py-32 px-6"
>
  <div
    class="absolute top-0 left-0 right-0 h-64 bg-gradient-to-b from-black to-transparent pointer-events-none"
  >
  </div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <h2
      class="text-5xl md:text-7xl text-white font-serif mb-20 text-center opacity-0 reveal-on-scroll"
    >
      Trabajos de Diseño e Ilustración
    </h2>

    <div class="columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
      {
        placeholderImages.map((img) => (
          <div class="reveal-item opacity-0 transform translate-y-8 break-inside-avoid overflow-hidden rounded-xl border border-white/10 hover:border-white/30 transition-all duration-300">
            <img
              src={img.src}
              alt={img.alt}
              class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const initRevealAnimation = () => {
    const h2Reveal = document.querySelector(".reveal-on-scroll");
    const itemsReveal = document.querySelectorAll(".reveal-item");

    const observerOptions = {
      root: null,
      rootMargin: "0px 0px -15% 0px",
      threshold: 0,
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.remove("opacity-0", "translate-y-8");
          entry.target.classList.add(
            "opacity-100",
            "translate-y-0",
            "transition-all",
            "duration-700",
            "ease-out",
          );
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    if (h2Reveal) revealObserver.observe(h2Reveal);
    itemsReveal.forEach((item) => revealObserver.observe(item));
  };

  initRevealAnimation();
</script>
